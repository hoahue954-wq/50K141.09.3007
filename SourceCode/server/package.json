{
  "name": "tap-hoa-hang-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  }
}
