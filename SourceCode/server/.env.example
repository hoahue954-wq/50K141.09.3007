# PostgreSQL connection string for the Supabase database
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/postgres?schema=public"

# Supabase project settings (the anon key is not a service-role key)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Required only by `npm run seed`; keep this key server-side and never expose it to web/
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-side-service-role-key"
EVIDENCE_STORAGE_BUCKET="slip-evidence"
SEED_OWNER_EMAIL="owner@taphoahang.local"
SEED_OWNER_PASSWORD="replace-with-a-unique-password-of-at-least-6-characters"
SEED_STAFF_EMAIL="staff@taphoahang.local"
SEED_STAFF_PASSWORD="replace-with-a-different-password-of-at-least-6-characters"

PORT=3000
FRONTEND_ORIGINS="http://localhost:5173"
DEFAULT_MIN_STOCK=5
